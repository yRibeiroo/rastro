{
  "name": "rastro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:completo": "node comandos/dev-completo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "next typegen && tsc --noEmit",
    "formatar": "prettier --write .",
    "formatar:verificar": "prettier --check .",
    "testar": "vitest run --project unidade --project unidade-componentes",
    "testar:cobertura": "vitest run --coverage --project unidade --project unidade-componentes",
    "testar:integracao": "vitest run --project integracao --passWithNoTests",
    "testar:e2e": "node comandos/ambiente-e2e.mjs playwright test",
    "testar:banco": "supabase test db",
    "lighthouse": "lhci autorun",
    "segredos": "node comandos/segredos.mjs",
    "registrar-webhook": "node --env-file=.env.local comandos/registrar-webhook.ts",
    "tipos-do-banco": "supabase gen types typescript --local > src/acesso-a-dados/supabase/tipos-do-banco.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "pluggy-js": "^0.19.3",
    "pluggy-sdk": "^0.92.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pluggy-connect": "^2.12.0",
    "server-only": "^0.0.1",
    "thinking-orbs": "0.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
