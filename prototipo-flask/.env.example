# Copie este arquivo para .env e preencha com suas credenciais REAIS da Pluggy.
# O .env NUNCA deve ir para o git nem para o frontend.
PLUGGY_CLIENT_ID=coloque-seu-client-id-aqui
PLUGGY_CLIENT_SECRET=coloque-seu-client-secret-aqui

# Segredo que a Pluggy envia no header Authorization de cada webhook.
# Gere um valor aleatório, por exemplo com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLUGGY_WEBHOOK_SECRET=gere-um-valor-aleatorio-aqui

FLASK_DEBUG=1
