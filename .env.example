# Variáveis de ambiente do Rastro.
# Copie para .env.local (ignorado pelo git) e preencha. Em produção/preview,
# cadastre-as no painel da Vercel (Settings → Environment Variables), nunca no código.
#
# [PÚBLICA]   vai para o navegador (prefixo NEXT_PUBLIC_). Nunca coloque segredo aqui.
# [SERVIDOR]  só existe no servidor; lida por src/configuracao/ambiente.ts.
# [SEGREDO]   servidor + sigiloso: nunca imprimir, logar nem versionar.

# --- Supabase -----------------------------------------------------------------
# [PÚBLICA] URL do projeto. Local: saída de `npx supabase status` (API URL).
# Produção: Supabase → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# [PÚBLICA] Chave publicável (sb_publishable_…). Local: `npx supabase status`.
# Produção: Supabase → Project Settings → API Keys → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [SEGREDO] Chave service_role / secret (ignora RLS). Local: `npx supabase status`.
# Produção: Supabase → Project Settings → API Keys → Secret key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso -------------------------------------------------------------------
# [SERVIDOR] E-mails autorizados a entrar, separados por vírgula (ADR 0008).
EMAIL_AUTORIZADO=

# --- Pluggy (Open Finance) ----------------------------------------------------
# [SEGREDO] Credenciais da aplicação: dashboard.pluggy.ai → Applications.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# [SEGREDO] Valor do cabeçalho "Authorization: Bearer …" que a Pluggy envia no
# webhook (ADR 0007). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e registre com `npm run registrar-webhook -- https://<domínio>/api/webhooks/pluggy`.
PLUGGY_WEBHOOK_SECRET=
# [SERVIDOR] 1 = mostra o conector sandbox (Pluggy Bank) no widget; 0 em produção real.
PLUGGY_INCLUIR_SANDBOX=

# --- Anthropic (categorização por IA) -----------------------------------------
# [SEGREDO] console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=
# [SERVIDOR] Opcional. Sobrescreve o modelo do classificador (padrão no código, ADR 0004).
ANTHROPIC_MODELO=

# --- Vercel -------------------------------------------------------------------
# [SEGREDO] Segredo da Vercel Cron (ela envia "Authorization: Bearer <CRON_SECRET>").
# Gere um valor aleatório de 32+ caracteres e cadastre na Vercel.
CRON_SECRET=
# [SERVIDOR] URL pública do site, sem barra final (ex.: http://localhost:3000).
# Usada no redirecionamento do link mágico (/entrar/confirmar).
URL_DO_SITE=

# --- Feature flags (ADR 0010): 1 = ligado, 0 = desligado ---------------------
# [SERVIDOR] padrão 1
RECURSO_CATEGORIZACAO_IA=
# [SERVIDOR] padrão 1
RECURSO_ANEXOS=
# [SERVIDOR] padrão 0
RECURSO_MULTIEMPRESA=
