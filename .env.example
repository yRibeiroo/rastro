# Modelo de variáveis. Copie para .env.local (local) ou cadastre na Vercel (produção).
# Nunca coloque valores reais neste arquivo.

# Supabase (públicas: vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (secreta: só no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Acesso: e-mails que podem entrar, separados por vírgula
EMAIL_AUTORIZADO=
# Endereço do site, sem barra no fim (links de login e webhooks)
URL_DO_SITE=

# Claude (categorização e leitura de comprovantes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=
ANTHROPIC_MODELO_COMPROVANTES=
IA_LIMITE_COMPROVANTES_MES=300

# Cron da Vercel (16+ caracteres)
CRON_SECRET=

# Pluggy (só com RECURSO_OPEN_FINANCE=1)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_INCLUIR_SANDBOX=0

# Recursos (0 ou 1)
RECURSO_CATEGORIZACAO_IA=1
RECURSO_ANEXOS=1
RECURSO_MULTIEMPRESA=0
RECURSO_OPEN_FINANCE=0
RECURSO_COMPROVANTES_IA=1
